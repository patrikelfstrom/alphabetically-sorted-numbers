    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "to-words": "^5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
